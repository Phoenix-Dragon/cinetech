{% extends 'base.html.twig' %}

{% block title %}Hello MovieController!{% endblock %}

{% block body %}

    {% if app.current_route == 'app_movie' %}
        <main class="min-h-screen bg-slate-950 px-4 py-12 sm:px-6 lg:px-8">
            <div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {% for movie in movies %}
                    <article class="group flex flex-col rounded-2xl border border-white/10 bg-slate-900 p-6 transition duration-200 hover:-translate-y-1 hover:border-amber-400/40 hover:shadow-xl hover:shadow-amber-500/10">

                        <div class="flex items-start justify-between gap-4">
                            <h1 class="text-xl font-bold leading-snug text-white">{{ movie.titre }}</h1>
                            <h2 class="inline-flex shrink-0 items-center gap-1 rounded-full bg-amber-400 px-3 py-1 text-sm font-bold text-slate-950">
                                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9l-5.2 2.8 1-5.9L1.5 7.7l5.9-.8L10 1.5z"/>
                                </svg>
                                {{ movie.notePresse }}
                            </h2>
                        </div>

                        <div class="mt-4 flex flex-1 flex-col">
                            <div class="flex items-center gap-3">
                                <h3 class="rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-xs font-medium text-amber-300">{{ movie.category.name }}</h3>
                                <h3 class="text-sm text-slate-400">{{ movie.dateSortie ? movie.dateSortie|date('d/m/Y') : '-' }}</h3>
                            </div>

                            <p class="mt-4 text-sm leading-relaxed text-slate-300">{{ movie.synopsis|slice(0, 100) }}</p>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </main>

    {% endif %} 

    {% if app.current_route == "app_movie_index" %}{% endif %}

    {% if app.current_route == "app_movie_show" %}{% endif %}

    
{% endblock %}
